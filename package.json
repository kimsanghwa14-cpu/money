{
  "name": "sang-family-ledger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "vite build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node tests/domain.test.ts && node tests/periods.test.ts",
    "test:db": "node tests/database.test.ts",
    "test:e2e": "playwright test",
    "build:next": "next build",
    "dev:pages": "vite --host 0.0.0.0 --port 3000",
    "preview:pages": "npm run build && wrangler pages dev dist --port 3000",
    "deploy:pages": "npm run build && wrangler pages deploy dist --project-name money",
    "test:pages": "node tests/pages.test.ts",
    "test:pages:browser": "playwright test --config playwright.pages.config.ts",
    "test:signup": "node tests/signup.test.ts",
    "test:assets": "node tests/assets.test.ts && node tests/asset-snapshot.test.ts",
    "test:dashboard": "node tests/dashboard.test.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.0",
    "next": "^16.3.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "wrangler": "^4.0.0"
  }
}
