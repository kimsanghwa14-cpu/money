# Supabase Project Settings > API 또는 Connect 화면. 공개 가능한 URL과 publishable key만 사용합니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 로컬 개발 주소. 배포 시 실제 https 주소로 바꿉니다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 선택: 별도의 테스트 DB에만 지정합니다. 운영 DB URL을 사용하지 마세요.
TEST_DATABASE_URL=
# 브라우저 통합 테스트 전용으로 승인된 테스트 가족 계정. 실제 계정은 사용하지 마세요.
E2E_EMAIL=
E2E_PASSWORD=
# 실제 데이터를 쓰지 않는 전용 테스트 가족에서만 true로 설정합니다.
E2E_ALLOW_WRITES=false
# 선택: 동시 수정 테스트용, 같은 테스트 가족의 두 번째 계정입니다.
E2E_SECOND_EMAIL=
E2E_SECOND_PASSWORD=
