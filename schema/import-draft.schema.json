{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "가족 가계부 가져오기 초안 v1",
  "type": "object", "additionalProperties": false,
  "required": ["version", "source_type", "records"],
  "properties": {
    "version": { "const": 1 },
    "source_type": { "enum": ["transaction_list", "mixed_workbook", "memo"] },
    "records": {
      "type": "array", "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["date", "owner", "kind", "major", "minor", "description", "amount", "payment_method", "account", "target_account", "status", "memo", "source_transaction_id", "original_transaction_id", "review_notes"],
        "properties": {
          "date": { "type": ["string", "null"], "format": "date" },
          "owner": { "enum": ["상화", "하율", "기타", null] },
          "kind": { "enum": ["income", "expense", "saving", "loan_principal", "transfer", "refund", "settlement", "loan_received", null] },
          "major": { "type": ["string", "null"], "maxLength": 80 },
          "minor": { "type": ["string", "null"], "maxLength": 80 },
          "description": { "type": "string", "minLength": 1, "maxLength": 120 },
          "amount": { "type": ["integer", "null"], "minimum": 1, "maximum": 1000000000000 },
          "payment_method": { "type": ["string", "null"], "maxLength": 80 },
          "account": { "type": ["string", "null"], "maxLength": 80 },
          "target_account": { "type": ["string", "null"], "maxLength": 80 },
          "status": { "enum": ["planned", "confirmed", "cancelled", null] },
          "memo": { "type": "string", "maxLength": 500 },
          "source_transaction_id": { "type": ["string", "null"], "maxLength": 200 },
          "original_transaction_id": { "type": ["string", "null"], "format": "uuid" },
          "review_notes": { "type": "array", "items": { "type": "string", "maxLength": 500 } }
        }
      }
    }
  }
}
